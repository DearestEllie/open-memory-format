{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DearestEllie/open-memory-format/main/schema/omf-1.1.schema.json",
  "title": "Open Memory Format 1.1",
  "description": "A complete family-archive export document. Minor versions are additive only, so every object allows unknown additional properties and only identity fields are required; SPEC.md is the normative document.",
  "type": "object",
  "properties": {
    "manifest": { "$ref": "#/$defs/manifest" },
    "archive": { "$ref": "#/$defs/archive" },
    "chapters": { "type": "array", "items": { "$ref": "#/$defs/chapter" } },
    "detailCards": { "type": "array", "items": { "$ref": "#/$defs/detailCard" } },
    "stories": { "type": "array", "items": { "$ref": "#/$defs/memory" } },
    "recipes": { "type": "array", "items": { "$ref": "#/$defs/memory" } },
    "timeline": { "type": "array", "items": { "$ref": "#/$defs/timelineEvent" } },
    "letters": { "type": "array", "items": { "$ref": "#/$defs/letter" } },
    "photos": { "type": "array", "items": { "$ref": "#/$defs/photo" } },
    "voices": { "type": "array", "items": { "$ref": "#/$defs/mediaItem" } },
    "thingsLoved": { "type": "array", "items": { "$ref": "#/$defs/thingLoved" } },
    "privateNotes": { "type": "array", "items": { "$ref": "#/$defs/privateNote" } },
    "contributors": { "type": "array", "items": { "$ref": "#/$defs/contributor" } },
    "media": { "type": "array", "items": { "$ref": "#/$defs/mediaItem" } },
    "mediaFiles": {
      "description": "The media verification manifest. Optional: early 1.0 documents predate it; readers treat absence as an empty list.",
      "type": "array",
      "items": { "$ref": "#/$defs/mediaFileManifestEntry" }
    },
    "readme": {
      "description": "Human-readable README explaining how to read the export without the producing host.",
      "type": "string"
    }
  },
  "required": [
    "manifest",
    "archive",
    "chapters",
    "detailCards",
    "stories",
    "recipes",
    "timeline",
    "letters",
    "photos",
    "voices",
    "thingsLoved",
    "privateNotes",
    "contributors",
    "media",
    "readme"
  ],
  "additionalProperties": true,
  "$defs": {
    "visibility": {
      "type": "string",
      "enum": ["private", "family", "contributor", "public", "hidden"]
    },
    "approvalStatus": {
      "type": "string",
      "enum": ["draft", "pending", "approved", "private", "aside", "rejected", "needs_clarification"]
    },
    "manifest": {
      "type": "object",
      "properties": {
        "$format": {
          "description": "Self-identification: the format's canonical URL. Added in 1.1; absent on 1.0 documents.",
          "const": "https://github.com/DearestEllie/open-memory-format"
        },
        "formatVersion": {
          "description": "major.minor. This schema covers any 1.x document.",
          "type": "string",
          "pattern": "^1\\.[0-9]+$"
        },
        "generatedAt": { "type": "string", "description": "ISO 8601 timestamp." },
        "archiveId": { "type": "string" },
        "archiveName": { "type": "string" },
        "counts": {
          "description": "Per-section record counts at generation time. No particular set of keys is required.",
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      },
      "required": ["formatVersion", "generatedAt", "archiveId", "archiveName", "counts"],
      "additionalProperties": true
    },
    "archive": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "name": { "type": "string" },
        "nickname": { "type": "string" },
        "relationship": { "type": "string" },
        "status": { "type": "string", "enum": ["living", "deceased", "memory_loss", "illness", "unknown"] },
        "subjectType": { "type": "string", "enum": ["self", "loved_one", "couple", "family", "community_elder"] },
        "birth": { "type": "string", "description": "As the family wrote it." },
        "death": { "type": "string", "description": "As the family wrote it; \"\" when not applicable." },
        "audience": { "type": "string" },
        "privacy": { "type": "string", "enum": ["private", "family", "public"] },
        "approvalMode": { "type": "string", "enum": ["all", "trusted", "none"] },
        "cover": {
          "type": "object",
          "properties": { "hue": { "type": "number" } },
          "additionalProperties": true
        },
        "intro": { "type": "string" },
        "why": { "type": "string" },
        "progress": {
          "type": "object",
          "properties": {
            "stories": { "type": "number" },
            "photos": { "type": "number" },
            "timeline": { "type": "number" },
            "letters": { "type": "number" },
            "contributors": { "type": "number" },
            "recordings": { "type": "number" },
            "pending": { "type": "number" }
          },
          "additionalProperties": true
        },
        "accent": { "type": "number" },
        "allowVisitorMemories": { "type": "boolean" },
        "allowSearchIndexing": { "type": "boolean" },
        "memorialGivingLabel": { "type": "string" },
        "memorialGivingUrl": { "type": "string" }
      },
      "required": ["id", "name"],
      "additionalProperties": true
    },
    "chapter": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "archiveId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "position": { "type": "number" },
        "visibility": { "$ref": "#/$defs/visibility" }
      },
      "required": ["id"],
      "additionalProperties": true
    },
    "detailCard": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "archiveId": { "type": "string" },
        "kind": { "type": "string" },
        "label": { "type": "string" },
        "value": { "type": "string" },
        "position": { "type": "number" },
        "visibility": { "$ref": "#/$defs/visibility" }
      },
      "required": ["id"],
      "additionalProperties": true
    },
    "memory": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "archiveId": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["story", "ordinary_day", "funny_story", "lesson", "quote", "thing_loved", "recipe", "place", "photo_story", "voice", "video", "legacy_note"]
        },
        "title": { "type": "string" },
        "contributor": { "type": "string" },
        "relationship": { "type": "string" },
        "era": { "type": "string", "description": "As written — \"the 60s\" stays \"the 60s\"." },
        "place": { "type": "string" },
        "people": { "type": "array", "items": { "type": "string" } },
        "section": { "type": "string" },
        "chapterId": { "type": "string" },
        "visibility": { "$ref": "#/$defs/visibility" },
        "status": { "$ref": "#/$defs/approvalStatus" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "body": { "type": "string" },
        "alternateOf": { "type": "string", "description": "Id of the memory this is another telling of; \"\" when it stands alone." }
      },
      "required": ["id"],
      "additionalProperties": true
    },
    "timelineEvent": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "archiveId": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string", "description": "As written." },
        "precision": { "type": "string", "enum": ["year", "decade", "month", "day", "approx"] },
        "category": { "type": "string" },
        "visibility": { "$ref": "#/$defs/visibility" },
        "desc": { "type": "string" }
      },
      "required": ["id"],
      "additionalProperties": true
    },
    "letter": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "archiveId": { "type": "string" },
        "author": { "type": "string" },
        "recipient": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string", "description": "As written." },
        "visibility": { "$ref": "#/$defs/visibility" },
        "status": { "$ref": "#/$defs/approvalStatus" },
        "body": { "type": "string" }
      },
      "required": ["id"],
      "additionalProperties": true
    },
    "photo": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "archiveId": { "type": "string" },
        "caption": { "type": "string" },
        "album": { "type": "string" },
        "era": { "type": "string", "description": "As written." },
        "hue": { "type": "number" },
        "visibility": { "$ref": "#/$defs/visibility" },
        "featured": { "type": "boolean" },
        "needsCaption": { "type": "boolean" }
      },
      "required": ["id"],
      "additionalProperties": true
    },
    "mediaItem": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "archiveId": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["audio", "video"] },
        "title": { "type": "string" },
        "duration": { "type": "string" },
        "contributor": { "type": "string" },
        "visibility": { "$ref": "#/$defs/visibility" },
        "transcript": { "type": "boolean" },
        "date": { "type": "string", "description": "As written." },
        "needsInfo": { "type": "boolean" }
      },
      "required": ["id"],
      "additionalProperties": true
    },
    "thingLoved": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "archiveId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "why": { "type": "string" },
        "emoji": { "type": "string" }
      },
      "required": ["id"],
      "additionalProperties": true
    },
    "privateNote": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "archiveId": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "visibility": { "$ref": "#/$defs/visibility" }
      },
      "required": ["id"],
      "additionalProperties": true
    },
    "contributor": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "archiveId": { "type": "string" },
        "name": { "type": "string" },
        "relationship": { "type": "string" },
        "permission": { "type": "string", "enum": ["submit_only", "viewer", "editor"] },
        "status": { "type": "string", "enum": ["active", "invited"] },
        "contributions": { "type": "number" },
        "isMinor": { "type": "boolean" },
        "guardianName": { "type": ["string", "null"] },
        "guardianApprovedAt": { "type": ["string", "null"], "description": "ISO timestamp when a guardian approved this minor's contributions." },
        "autoApprove": { "type": "boolean" }
      },
      "required": ["id"],
      "additionalProperties": true
    },
    "mediaFileManifestEntry": {
      "type": "object",
      "properties": {
        "mediaId": { "type": "string", "description": "Id of the media/photo record this original belongs to." },
        "mediaType": { "type": "string", "enum": ["audio", "video", "photo"] },
        "storageKey": { "type": "string", "description": "In the zip variant, the original's bytes live at media/<storageKey>." },
        "checksumSha256": { "type": ["string", "null"], "description": "Lowercase hex SHA-256 of the original bytes; null only on legacy rows." },
        "byteSize": { "type": ["number", "null"] },
        "originalFilename": { "type": ["string", "null"] },
        "contentType": { "type": ["string", "null"] }
      },
      "required": ["mediaId", "mediaType", "storageKey"],
      "additionalProperties": true
    }
  }
}
